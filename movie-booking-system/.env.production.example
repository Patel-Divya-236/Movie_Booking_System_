# .env for the EC2 instance — copy to .env on the server.
#
# The key difference from local development: NO AWS credentials and NO
# DynamoDB endpoint. The instance's IAM role supplies credentials
# automatically, which is why nothing secret about AWS lives in this file.

PORT=3000

# Generate a fresh one, do not reuse the development value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# Must match the region your DynamoDB tables and SNS topic live in.
AWS_REGION=ap-south-1

# Deliberately absent — do not add these on EC2:
#   DYNAMODB_ENDPOINT      (local development only)
#   AWS_ACCESS_KEY_ID      (the IAM role provides credentials)
#   AWS_SECRET_ACCESS_KEY

# SMTP credentials — the only mail path. An App Password, not the account
# password. Any SMTP provider works via SMTP_HOST/PORT/USER/PASS instead.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Printed by aws-setup.js.
SNS_BOOKING_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:cinecloud-bookings

# Free key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=
