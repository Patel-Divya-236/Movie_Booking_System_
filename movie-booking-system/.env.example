PORT=3000
JWT_SECRET=change_this_to_a_long_random_string

# ---------- Admin account ----------
# Used by setup-tables.js when creating the admin user.
# Leave ADMIN_PASSWORD blank and the seed generates one and prints it once.
ADMIN_EMAIL=admin@moviebooking.com
ADMIN_PASSWORD=

# ---------- AWS ----------
AWS_REGION=ap-south-1

# Local development only — point at DynamoDB Local.
# Leave this UNSET in production so the AWS SDK talks to real DynamoDB
# using the EC2 instance's IAM role.
# DYNAMODB_ENDPOINT=http://localhost:8000

# Credentials are only needed when running outside EC2 (e.g. your laptop).
# On EC2 the attached IAM role supplies them automatically — leave blank.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---------- Email ----------
# SMTP only. Amazon SES was removed: it never left the sandbox, where it
# refuses every unverified recipient, so it always failed before falling
# through to SMTP anyway. Leave blank to disable email — bookings still work.

# Gmail. Needs 2-Step Verification on the Google account, then an App Password
# from https://myaccount.google.com/apppasswords
# (This is an App Password, never your account password.)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Any other SMTP provider instead (Brevo, SendGrid, SMTP2GO, Mailjet).
# These take precedence over GMAIL_* when set.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Optional display sender; defaults to the SMTP/Gmail user.
# MAIL_FROM=

# Used to build links in emails (verification, support threads).
APP_BASE_URL=http://localhost:3000

# ---------- Movie catalog (TMDB) ----------
# Free key from https://www.themoviedb.org/settings/api
# With this set, the seed pulls films currently in Indian cinemas (Hindi /
# English / Gujarati) with real posters and official trailers.
# Without it, the static fallback list in config/seedData.js is used.
TMDB_API_KEY=
# Alternatively a v4 read access token:
# TMDB_ACCESS_TOKEN=

# ---------- Admin alerts (Amazon SNS) ----------
# Topic ARN that receives a message on every booking. Optional.
SNS_BOOKING_TOPIC_ARN=
